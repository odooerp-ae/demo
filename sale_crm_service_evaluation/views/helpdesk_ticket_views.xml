<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_form_service_evaluation" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.service.evaluation</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_project_task_wizard"
                    string="Create Project Task"
                    type="object"
                    class="btn-primary"
                    invisible="not stage_id.is_unsatisfactory"/>
            </xpath>
        </field>
    </record>
</odoo>
