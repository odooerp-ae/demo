<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_stage_form_unsatisfactory" model="ir.ui.view">
        <field name="name">helpdesk.ticket.stage.form.unsatisfactory</field>
        <field name="model">helpdesk.ticket.stage</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='closed']" position="after">
                <field name="is_unsatisfactory"/>
            </xpath>
        </field>
    </record>
</odoo>
