<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_survey_send_wizard_form" model="ir.ui.view">
        <field name="name">crm.lead.survey.send.wizard.form</field>
        <field name="model">crm.lead.survey.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Survey">
                <group>
                    <field name="crm_lead_id" invisible="1"/>
                    <field name="survey_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_send_survey" string="Send Survey" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
