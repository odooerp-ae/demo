<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_project_task_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.project.task.wizard.form</field>
        <field name="model">helpdesk.ticket.project.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Project Task">
                <group>
                    <field name="ticket_id" invisible="1"/>
                    <field name="project_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_create_task" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
